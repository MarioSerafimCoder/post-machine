    {
      "rule_id": "TTL-001",
      "name": "Promessa do título compatível",
      "category": "TTL",
      "level": "blocking",
      "check_type": "review_required",
      "when": "Toda peça com headline",
      "action": "Checar que o conteúdo entrega a promessa e evita exagero.",
