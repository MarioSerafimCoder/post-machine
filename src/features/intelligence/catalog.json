      "name": "Conflito entre fontes",
      "category": "SRC",
      "level": "blocking",
      "check_type": "review_required",
      "when": "Fontes relevantes discordam sobre mesma alegação",
      "action": "Registrar versões, apresentar divergência e solicitar decisão editorial; não fabricar consenso.",
      "exceptions": [],
      "validation": "Conflito não resolvido marca campaign.status = needs_review.",
      "reason": "",
      "version": "2.0.0",
      "updated_at": "2026-11-16",
      "sourceIds": [
        "F44",
        "F45"
      ],
      "evidenceIds": []
    },
    {
      "rule_id": "SRC-006",
      "name": "Citação direta e integridade",
      "category": "SRC",
      "level": "blocking",
      "check_type": "review_required",
      "when": "Citação textual atribuída",
      "action": "Exigir trecho exato e autoria/contexto; impedir citação fabricada.",
