  "rules": [
    {
      "rule_id": "SRC-001",
      "name": "Fonte por alegação factual",
      "category": "SRC",
      "level": "blocking",
      "check_type": "review_required",
      "when": "Alegação factual em texto, imagem ou legenda",
      "action": "Vincular claim_id a pelo menos uma fonte acessada e trecho/evidência; suspender aprovação sem suporte.",
      "exceptions": [
        "Ficção rotulada; opinião explicitamente identificada"
      ],
      "validation": "Obrigatório registrar claim_id, source_id, trecho e decisão de suporte.",
      "reason": "",
      "version": "2.0.0",
      "updated_at": "2026-11-16",
      "sourceIds": [
        "F04",
        "F44"
      ],
      "evidenceIds": []
    },
    {
      "rule_id": "SRC-002",
      "name": "Não extrapolar fonte parcial",
      "category": "SRC",
      "level": "blocking",
      "check_type": "review_required",
      "when": "source_access != full_text",
      "action": "Não inferir método, conclusão ou detalhe que não conste da parte consultada.",
      "exceptions": [],
      "validation": "Alegações precisam caber no conteúdo efetivamente disponível.",
      "reason": "",
      "version": "2.0.0",
      "updated_at": "2026-11-16",
      "sourceIds": [
        "F04",
        "F45"
      ],
      "evidenceIds": []
    },
    {
      "rule_id": "SRC-003",
      "name": "Separar associação de causalidade",
      "category": "SRC",
      "level": "blocking",
      "check_type": "review_required",
      "when": "Origem observacional ou insuficiente para causalidade",
      "action": "Bloquear declaração causal não sustentada; reescrever como associação.",
      "exceptions": [],
      "validation": "Comparar linguagem causal com desenho do estudo.",
      "reason": "",
      "version": "2.0.0",
      "updated_at": "2026-11-16",
      "sourceIds": [
        "F10",
        "F20"
      ],
      "evidenceIds": []
    },
    {
      "rule_id": "SRC-004",
      "name": "Estado de acesso explícito",
      "category": "SRC",
      "level": "blocking",
      "check_type": "deterministic",
      "when": "Toda fonte anexada",
      "action": "Exigir source_access em enum de acesso; registrar accessed_at.",
      "exceptions": [],
      "validation": "Campo source_access deve existir e ser válido.",
      "reason": "",
      "version": "2.0.0",
      "updated_at": "2026-11-16",
      "sourceIds": [
        "F04"
      ],
      "evidenceIds": []
    },
    {
