    {
      "rule_id": "TTL-002",
      "name": "Pergunta não é padrão universal",
      "category": "TTL",
      "level": "experimental",
      "check_type": "editorial",
      "when": "Seleção de headline",
      "action": "Oferecer título interrogativo só como variante, com justificativa e teste.",
